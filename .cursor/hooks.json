{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python .cursor/hooks/session_start.py",
        "timeout": 20
      }
    ],
    "afterFileEdit": [
      {
        "command": "python .cursor/hooks/after_safemining_edit.py",
        "matcher": "Write|Edit|ApplyPatch|StrReplace",
        "timeout": 15
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python .cursor/hooks/before_xr_mcp.py",
        "timeout": 10
      }
    ]
  }
}
